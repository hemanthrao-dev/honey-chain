# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=honeychain-production-secure-jwt-secret-key-sih2026-kvic-mission-do-not-expose
JWT_EXPIRES_IN=7d

# Cookie Security (Set COOKIE_SECURE=true in HTTPS production)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database Configuration
DB_PATH=./backend/data/honey_chain.db

# CORS Configuration (comma-separated origins)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://hemanthrao-dev.github.io

# Security Settings
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
